# Telegram Bot Token (lấy từ @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Tùy chọn nhiều API key (phân tách bằng dấu phẩy) để chia tải & dự phòng chéo khi gặp 429
GEMINI_API_KEYS=your_primary_key,your_secondary_key

# Telegram User ID của bạn (nhắn /id cho @userinfobot để lấy)
# Nếu để 0, bot tự động khóa quyền quản trị vào tài khoản đầu tiên bấm /start
ALLOWED_USER_ID=0

# Cấu hình nhân vật AI Quản gia / Trợ lý
BUTLER_NAME=Atlas
OWNER_NAME=bạn
# Phong cách: butler | assistant | companion
BUTLER_STYLE=butler
# Thành phố tra thời tiết sáng cho bản tin hằng ngày (định dạng wttr.in, vd: Ho_Chi_Minh_City, Hanoi, Da_Nang)
WEATHER_CITY=Ho_Chi_Minh_City
TIMEZONE_OFFSET_HOURS=7

# Cấu hình Model Gemini
CHAT_MODEL=gemini-3.1-flash-lite
MEMORY_MODEL=gemini-3.5-flash-lite
REVIEW_MODEL=gemini-3.1-flash-lite

# File SQLite Database
DB_PATH=smart_butler.db

# Web Dashboard & cổng MCP JSON-RPC 2.0 (http://<IP>:8080/mcp)
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Đặt mã PIN cố định cho Dashboard & MCP Bearer auth (để trống = tự sinh ngẫu nhiên và lưu DB)
DASHBOARD_PIN=

# VieNeu-TTS Server (tùy chọn: chạy trên PC LAN để gửi Voice Note Telegram)
TTS_API_URL=
TTS_API_KEY=

# PC LAN Music Download Bridge (tùy chọn: chạy tools/music_download_server.py trên PC)
MUSIC_DL_API_URL=
MUSIC_DL_API_KEY=

# Ổ cứng / USB gắn ngoài tùy chọn (lưu cache nhạc & bản sao lưu phụ)
USB_STORAGE_DIR=/mnt/usb
